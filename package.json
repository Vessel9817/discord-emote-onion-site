{
    "name": "discord-emote-onion-site_",
    "version": "0.0.0",
    "license": "MIT",
    "main": "app.ts",
    "type": "module",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Vessel9817/discord-emote-onion-site.git"
    },
    "homepage": "https://github.com/Vessel9817/discord-emote-onion-site#readme",
    "readme": "https://github.com/Vessel9817/discord-emote-onion-site/blob/main/README.md",
    "bugs": {
        "url": "https://github.com/Vessel9817/discord-emote-onion-site/issues"
    },
    "scripts": {
        "test": "mocha --exit --fail-zero test/**/*.spec.ts",
        "start": "node --env-file=./secrets/.env ./dist/index.cjs",
        "build": "node --run=build:prod",
        "build:prod": "cross-env NODE_ENV=\"production\" NODE_OPTIONS=\"--import tsx\" webpack -c ./onion-website/src/express/webpack/webpack.config.ts",
        "build:dev": "cross-env NODE_ENV=\"development\" NODE_OPTIONS=\"--import tsx\" webpack -c ./onion-website/src/express/webpack/webpack.config.ts",
        "tsc": "tsc --noEmit"
    },
    "dependencies": {
        "cors": "^2.8.6",
        "ejs": "^6.0.1",
        "express": "^5.2.1",
        "express-validator": "^7.3.2",
        "mongoose": "^9.7.2"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/mocha": "^10.0.10",
        "@types/mongodb-memory-server": "^1.8.0",
        "@types/node": "^26.0.1",
        "clean-webpack-plugin": "^4.0.0",
        "cross-env": "^10.1.0",
        "mocha": "^11.7.6",
        "mongodb-memory-server": "^11.2.0",
        "terser-webpack-plugin": "^5.6.1",
        "ts-loader": "^9.6.2",
        "tslib": "^2.8.1",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "webpack": "^5.108.0",
        "webpack-cli": "^7.0.3"
    }
}
