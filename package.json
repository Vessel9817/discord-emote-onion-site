{
    "name": "discord-emote-onion-site_",
    "version": "0.0.0",
    "license": "MIT",
    "main": "app.ts",
    "type": "module",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Vessel9817/discord-emote-onion-site.git"
    },
    "homepage": "https://github.com/Vessel9817/discord-emote-onion-site#readme",
    "readme": "https://github.com/Vessel9817/discord-emote-onion-site/blob/main/README.md",
    "bugs": {
        "url": "https://github.com/Vessel9817/discord-emote-onion-site/issues"
    },
    "scripts": {
        "test": "mocha --exit --fail-zero test/**/*.spec.ts",
        "start": "node --env-file=./secrets/.env ./dist/index.cjs",
        "build": "node --run=build:prod",
        "build:prod": "cross-env NODE_ENV=\"production\" tsx ./onion-website/src/express/webpack/index.ts",
        "build:dev": "cross-env NODE_ENV=\"development\" tsx ./onion-website/src/express/webpack/index.ts",
        "tsc": "tsc --noEmit"
    },
    "dependencies": {
        "cors": "^2.8.6",
        "ejs": "^6.0.1",
        "express": "^5.2.1",
        "express-validator": "^7.3.2",
        "mongoose": "^9.9.1"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/mocha": "^10.0.10",
        "@types/mongodb-memory-server": "^1.8.0",
        "@types/node": "^26.1.2",
        "@typescript/native": "npm:typescript@^7.0.2",
        "cross-env": "^10.1.0",
        "mocha": "^12.0.0-rc.6",
        "mongodb-memory-server": "^11.2.0",
        "terser-webpack-plugin": "^5.6.1",
        "ts-loader": "^9.6.2",
        "tslib": "^2.8.1",
        "tsx": "^4.23.5",
        "webpack": "^5.109.2"
    }
}
